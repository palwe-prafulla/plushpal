<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>ToyTalk Hub</string>
  <key>CFBundleExecutable</key><string>ToyTalk Hub</string>
  <key>CFBundleIdentifier</key><string>com.toytalk.hub</string>
  <key>CFBundleName</key><string>ToyTalk Hub</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>ToyTalk uses the microphone only when you tap to talk in the local Mac client.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>ToyTalk uses on-device speech recognition only when you tap to talk in the Mac client.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key><true/>
  </dict>
</dict></plist>
